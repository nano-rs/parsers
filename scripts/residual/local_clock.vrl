# NAN local clock. Generated by scripts/residual_spill.py from scripts/residual/local_clock.vrl.
# __VAR__ was just parsed from a clock WITHOUT an offset, read as UTC
# (__lc_pending). It becomes real UTC here, at the site, with the log source's
# timezone (__src_tz / __src_shift_ms from the prelude, or an inline IANA zone
# the parser validated): a fixed offset by arithmetic; an IANA zone with its DST
# rules, probed 18 h either side (wider than any UTC offset), an ambiguous
# fall-back time taking its FIRST occurrence (the earlier offset), a time in a
# spring-forward gap moving forward by the gap. __NOYEAR__: a clock with no
# year is tried in its year, the year before and the year after (each with its
# own DST rules); more than a day in the future means last year, more than 180
# days in the past means next year when that is not in the future.
if __lc_pending {
    __lc_pending = false
    __time_assumed = true
    __lc_l = to_unix_timestamp(__VAR__, unit: "milliseconds")
    __lc_cands = [__lc_l]
    if __NOYEAR__ {
        __lc_s = format_timestamp!(__VAR__, "%Y-%m-%d %H:%M:%S%.3f")
        __lc_y = to_int(slice!(__lc_s, 0, 4)) ?? 0
        __lc_p, __lc_pe = parse_timestamp(to_string(__lc_y - 1) + slice!(__lc_s, 4), "%Y-%m-%d %H:%M:%S%.3f", timezone: "UTC")
        __lc_n, __lc_ne = parse_timestamp(to_string(__lc_y + 1) + slice!(__lc_s, 4), "%Y-%m-%d %H:%M:%S%.3f", timezone: "UTC")
        __lc_pm = null
        if __lc_pe == null { __lc_pm = to_unix_timestamp(__lc_p, unit: "milliseconds") }
        __lc_nm = null
        if __lc_ne == null { __lc_nm = to_unix_timestamp(__lc_n, unit: "milliseconds") }
        __lc_cands = [__lc_l, __lc_pm, __lc_nm]
    }
    __lc_us = map_values(__lc_cands) -> |l| {
        if l == null {
            null
        } else {
            __u = int!(l) - __src_shift_ms
            if __src_tz != "UTC" {
                __offs = map_values([int!(l) - 64800000, int!(l) + 64800000]) -> |at| {
                    __z = format_timestamp(from_unix_timestamp!(at, unit: "milliseconds"), "%z", timezone: __src_tz) ?? "+0000"
                    __o = ((to_int(slice(__z, 1, 3) ?? "0") ?? 0) * 3600 + (to_int(slice(__z, 3, 5) ?? "0") ?? 0) * 60) * 1000
                    if starts_with(__z, "-") { 0 - __o } else { __o }
                }
                __oa = int!(__offs[0])
                __ob = int!(__offs[1])
                __u = int!(l) - __oa
                if __oa != __ob {
                    __ok = map_values([int!(l) - __oa, int!(l) - __ob]) -> |at| {
                        __z = format_timestamp(from_unix_timestamp!(at, unit: "milliseconds"), "%z", timezone: __src_tz) ?? "+0000"
                        __o = ((to_int(slice(__z, 1, 3) ?? "0") ?? 0) * 3600 + (to_int(slice(__z, 3, 5) ?? "0") ?? 0) * 60) * 1000
                        if starts_with(__z, "-") { 0 - __o } else { __o }
                    }
                    if int!(__ok[0]) != __oa && int!(__ok[1]) == __ob { __u = int!(l) - __ob }
                }
            }
            __u
        }
    }
    __lc_u = int!(__lc_us[0])
    if __NOYEAR__ {
        if __lc_u > __src_now_ms + 86400000 && __lc_us[1] != null {
            __lc_u = int!(__lc_us[1])
        } else if __lc_u < __src_now_ms - 15552000000 && __lc_us[2] != null && int!(__lc_us[2]) <= __src_now_ms + 86400000 {
            __lc_u = int!(__lc_us[2])
        }
    }
    # Remembered (local -> UTC) so a transforms rule on the same source clock
    # still finds it at its target.
    if __lc_u != __lc_l { __lc_shifted = __lc_shifted + "\n" + to_string(__lc_l) + "\t" + to_string(__lc_u) + "\n" }
    __VAR__ = from_unix_timestamp!(__lc_u, unit: "milliseconds")
}
# END NAN local clock
