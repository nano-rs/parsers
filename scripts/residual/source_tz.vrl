# NAN source timezone. Generated by scripts/residual_spill.py; edit scripts/residual/source_tz.vrl.
# The log source's timezone setting arrives as .nano.source_timezone (an IANA
# name such as "America/New_York", or any fixed offset such as "+05:30"), set
# by nano at ingest. .nano is nano's input, never part of the log: it is
# removed whole before anything else, whatever its shape.
# For a clock that carries no offset a parser parses it AS UTC and sets
# __lc_pending; the generated local-clock block that follows the parse
# (local_clock.vrl) turns it into real UTC with this setting, and the spill
# records the zone used as unmapped.nano_time_assumed_tz (the name, the offset
# as +HH:MM, or "UTC" when the setting is absent, invalid or "local").
__src_nano = del(.nano)
__src_tz_in = ""
if is_object(__src_nano) { __src_tz_in = strip_whitespace(to_string(object!(__src_nano).source_timezone) ?? "") }
__src_tz = "UTC"
__src_shift_ms = 0
__src_tz_label = "UTC"
__time_assumed = false
__time_inline = false
__lc_pending = false
__src_off = parse_regex(__src_tz_in, r'^(?P<sign>[+-])(?P<h>\d{2}):?(?P<m>\d{2})$') ?? {}
if !is_empty(__src_off) {
    __src_h = to_int(__src_off.h) ?? 99
    __src_m = to_int(__src_off.m) ?? 99
    if __src_h <= 14 && __src_m <= 59 {
        __src_shift_ms = (__src_h * 3600 + __src_m * 60) * 1000
        if __src_off.sign == "-" { __src_shift_ms = 0 - __src_shift_ms }
        if __src_shift_ms != 0 { __src_tz_label = string!(__src_off.sign) + string!(__src_off.h) + ":" + string!(__src_off.m) }
    }
} else if __src_tz_in != "" && downcase(__src_tz_in) != "local" {
    # "local" (the Vector host's zone) would make the time depend on the host.
    __src_probe, __src_probe_err = parse_timestamp("2000-01-01 00:00:00", "%Y-%m-%d %H:%M:%S", timezone: __src_tz_in)
    if __src_probe_err == null { __src_tz = __src_tz_in; __src_tz_label = __src_tz_in }
}
#year{
# A clock with no year: the current year in the source's zone, and the latest
# leap year for a Feb 29 (the local-clock block then picks the nearest year).
__src_now_ms = to_unix_timestamp(now(), unit: "milliseconds")
__src_year = format_timestamp(from_unix_timestamp!(__src_now_ms + __src_shift_ms, unit: "milliseconds"), "%Y", timezone: __src_tz) ?? format_timestamp!(now(), "%Y")
__src_leap_year = to_int(__src_year) ?? 2000
if mod(__src_leap_year, 4) != 0 || (mod(__src_leap_year, 100) == 0 && mod(__src_leap_year, 400) != 0) { __src_leap_year = __src_leap_year - mod(__src_leap_year, 4) }
__src_leap_year = to_string(__src_leap_year)
#}year
# END NAN source timezone
