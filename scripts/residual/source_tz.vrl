# NAN source timezone. Generated by scripts/residual_spill.py; edit scripts/residual/source_tz.vrl.
# The log source's timezone setting arrives as .nano.source_timezone (an IANA
# name such as "America/New_York", or a fixed offset such as "+05:30"), set by
# nano at ingest. It is read and removed before anything else, so it is never
# part of the log. For a clock that carries no offset a parser passes
# timezone: __src_tz and, when the parse succeeds, sets __time_assumed and
# subtracts __src_shift_ms (a fixed offset); the spill records the zone used
# (__src_tz_label: the IANA name, the offset, or "UTC" when the setting is
# absent or invalid) as unmapped.nano_time_assumed_tz.
__src_tz_in = ""
if is_object(.nano) {
    __src_tz_in = strip_whitespace(to_string(del(.nano.source_timezone)) ?? "")
    if is_empty(object!(.nano)) { __discard = del(.nano) }
}
__src_tz = "UTC"
# A fixed offset applies to any valid +HH:MM / -HH:MM (or HHMM): the clock is
# read as UTC and shifted by __src_shift_ms (UTC = local - offset). An IANA
# name goes to parse_timestamp as the timezone, DST included.
__src_shift_ms = 0
__src_tz_label = "UTC"
__time_assumed = false
__src_off = parse_regex(__src_tz_in, r'^(?P<sign>[+-])(?P<h>\d{2}):?(?P<m>\d{2})$') ?? {}
if !is_empty(__src_off) {
    __src_h = to_int(__src_off.h) ?? 99
    __src_m = to_int(__src_off.m) ?? 99
    if __src_h <= 14 && __src_m <= 59 {
        __src_shift_ms = (__src_h * 3600 + __src_m * 60) * 1000
        if __src_off.sign == "-" { __src_shift_ms = 0 - __src_shift_ms }
        if __src_shift_ms != 0 { __src_tz_label = string!(__src_off.sign) + string!(__src_off.h) + ":" + string!(__src_off.m) }
    }
} else if __src_tz_in != "" {
    __src_probe, __src_probe_err = parse_timestamp("2000-01-01 00:00:00", "%Y-%m-%d %H:%M:%S", timezone: __src_tz_in)
    if __src_probe_err == null { __src_tz = __src_tz_in; __src_tz_label = __src_tz_in }
}
# END NAN source timezone
