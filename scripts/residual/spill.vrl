# NAN-2421 residual spill. Generated by scripts/residual_spill.py; edit the template.
# Values spill exactly as parsed: a parser never masks, redacts or withholds
# anything (masking is an opt-in pipeline step, never a parser concern).
# __source_kv is a local variable, never an OCSF attribute. The checker instruments
# this marker to observe the parsed source without changing production output.
# A source field is consumed ONLY by an explicit mapping: a field-coverage.yaml
# `mappings` entry (source key -> target paths) or a `transforms` rule with a
# target, whose value is found AT THAT TARGET PATH of the selected branch. A
# value that merely appears somewhere else in the event never consumes a field
# (no coincidental consumption); everything else spills.
# NAN-5351: VRL copies a variable on every read, so an array or object used as a
# lookup set costs a full copy per lookup. The sets below are strings instead
# (a read shares the buffer). __repr holds one member per mapped leaf:
# "," + encode_json(path) + "=" + encode_json(encode_json(value)), plus the
# to_string form for a string or a float, so a numeric string is represented by
# its typed scalar. Every part is a JSON text, inside which a '"' is always
# escaped, so a member is matched exactly. Paths drop array indices
# (resources.0.uid is resources.uid); arrays are walked two levels deep, and a
# leaf deeper than that is simply not mapping evidence (it can only spill more).
# raw_data and unmapped are dropped before the JSON round trip, not after it.
__mapped = .
__discard = del(__mapped.raw_data)
__existing = del(__mapped.unmapped)
__existing = object(parse_json!(encode_json(__existing))) ?? {}
__mapped = object!(parse_json!(encode_json(__mapped)))
if __mapped.message == __raw_body { __discard = del(__mapped.message) }
__copy = object!(parse_json!(encode_json({"source": __source_kv, "existing": __existing})))
__repr = ""
for_each(flatten(__mapped)) -> |path, value| {
    __p = encode_json(path)
    if is_array(value) {
        for_each(array!(value)) -> |_i, item| {
            if is_object(item) {
                for_each(flatten(object!(item))) -> |sub, leaf| {
                    __q = encode_json(path + "." + sub)
                    if is_array(leaf) {
                        for_each(array!(leaf)) -> |_j, x| {
                            if !is_object(x) && !is_array(x) {
                                __repr = __repr + ("," + __q + "=" + encode_json(encode_json(x)))
                                if is_string(x) || is_float(x) { __repr = __repr + ("," + __q + "=" + encode_json(to_string!(x))) }
                            }
                        }
                    } else {
                        __repr = __repr + ("," + __q + "=" + encode_json(encode_json(leaf)))
                        if is_string(leaf) || is_float(leaf) { __repr = __repr + ("," + __q + "=" + encode_json(to_string!(leaf))) }
                    }
                }
            } else if !is_array(item) {
                __repr = __repr + ("," + __p + "=" + encode_json(encode_json(item)))
                if is_string(item) || is_float(item) { __repr = __repr + ("," + __p + "=" + encode_json(to_string!(item))) }
            }
        }
    } else {
        __repr = __repr + ("," + __p + "=" + encode_json(encode_json(value)))
        if is_string(value) || is_float(value) { __repr = __repr + ("," + __p + "=" + encode_json(to_string!(value))) }
    }
}
__consumed = ""
# Escape literal dots before flattening so dotted source keys cannot overwrite
# nested paths. Decode for naming, and disambiguate collisions with suffixes.
# In compact JSON only an object key is followed by ':', so a source whose text
# has no '.' or '~' followed by the rest of a string and then ':' has no key to
# escape. ('.' and '~' are never the escaped half of a JSON escape.)
__escaped = object!(__copy.source)
__tilde = false
if match(encode_json(__escaped), r'[.~](?:[^"\\]|\\.)*":') {
    __escaped = map_keys(__escaped, recursive: true) -> |key| {
        replace(replace(key, "~", "~0"), ".", "~1")
    }
    # Keys without a "~" decode to themselves, including the object keys inside
    # an array that flatten leaves escaped; encode_json never escapes a "~".
    __tilde = contains(encode_json(__escaped), "~")
}
__flat = flatten(__escaped)
# BEGIN parser-specific transformations
__TRANSFORMS__
# END parser-specific transformations
# Declared mappings: __decl holds "\n" + encode_json(key) + "\t" + JSON array of
# target paths + "\n" per mapped source key (a raw newline never occurs in
# compact JSON). A key is consumed when its value, or every element of a scalar
# array, is at one of its own targets. Keys stay ESCAPED here and in __consumed:
# a literal dotted key ("a~1b") and the nested path ("a.b") are different
# fields, and mapping one never consumes the other.
for_each(__flat) -> |key, value| {
    # __decl spells a bracket inside a key as a \u escape (deploy bracket count).
    __kt = encode_json(key)
    if match(__kt, r'[\x28\x29\x5B\x5D\x7B\x7D]') {
        __kt = replace(replace(replace(replace(replace(replace(__kt, r'\x28', "\\u0028"), r'\x29', "\\u0029"), r'\x5B', "\\u005b"), r'\x5D', "\\u005d"), r'\x7B', "\\u007b"), r'\x7D', "\\u007d")
    }
    __at = find(__decl, "\n" + __kt + "\t")
    if is_integer(__at) && !is_object(value) {
        __rest = slice!(__decl, int!(__at) + strlen(__kt) + 2)
        __hit = false
        for_each(array!(parse_json!(slice!(__rest, 0, int!(find(__rest, "\n")))))) -> |_i, target| {
            __tok = "," + encode_json(target) + "="
            if !__hit && is_array(value) {
                __all = !is_empty(array!(value))
                for_each(array!(value)) -> |_j, item| {
                    if __all {
                        __all = !is_object(item) && !is_array(item) && (contains(__repr, __tok + encode_json(encode_json(item))) || ((is_string(item) || is_float(item)) && contains(__repr, __tok + encode_json(to_string!(item)))))
                    }
                }
                __hit = __all
            } else if !__hit {
                __hit = contains(__repr, __tok + encode_json(encode_json(value))) || ((is_string(value) || is_float(value)) && contains(__repr, __tok + encode_json(to_string!(value))))
            }
        }
        if __hit { __consumed = __consumed + ("," + encode_json(key)) }
    }
}
# Fast path: when no two source keys decode to the same key and no two spilled
# keys get the same name, each key's decision depends only on its own value, so
# one filter and one rename build the residual without copying it per key.
__distinct = true
if __tilde {
    __distinct = length(map_keys(__flat) -> |key| { replace(replace(key, "~1", "."), "~0", "~") }) == length(__flat)
}
__kept = {}
__names = {}
if __distinct {
    __kept = filter(__flat) -> |key, value| {
        # A key is kept unless an explicit mapping or transformation consumed it.
        # Do not spill a copy of the raw body.
        value != __raw_body && !contains(__consumed, "," + encode_json(key))
    }
    __names = map_keys(__kept) -> |key| {
        if __tilde { key = replace(replace(key, "~1", "."), "~0", "~") }
        __parts = map_values(split(key, ".")) -> |part| { snakecase(string!(part)) }
        join!(__parts, ".")
    }
}
__residual = {}
if __distinct && length(__names) == length(__kept) {
    __residual = map_values(__names) -> |value| {
        if is_array(value) || is_object(value) {
            if __tilde {
                value = get!(map_keys({"v": value}, recursive: true) -> |inner| {
                    replace(replace(inner, "~1", "."), "~0", "~")
                }, ["v"])
            }
            __complex = is_object(value)
            if is_array(value) {
                for_each(array!(value)) -> |_index, item| {
                    if is_object(item) || is_array(item) { __complex = true }
                }
            }
            if __complex { value = encode_json(value) }
        }
        value
    }
} else {
    # Slow path, in source key order: a name already taken gets the next free
    # _2, _3, ... suffix.
    for_each(__flat) -> |key, value| {
        __token = "," + encode_json(key)
        key = replace(replace(key, "~1", "."), "~0", "~")
        if is_array(value) || is_object(value) {
            value = get!(map_keys({"v": value}, recursive: true) -> |inner| {
                replace(replace(inner, "~1", "."), "~0", "~")
            }, ["v"])
        }
        if !contains(__consumed, __token) && value != __raw_body {
            __parts = map_values(split(key, ".")) -> |part| { snakecase(string!(part)) }
            __base = join!(__parts, ".")
            __key = __base
            __suffix = 2
            if includes(keys(__residual), __key) {
                for_each(__flat) -> |_other_key, _other_value| {
                    if includes(keys(__residual), __key) {
                        __key = __base + "_" + to_string(__suffix)
                        __suffix = __suffix + 1
                    }
                }
            }
            __complex = is_object(value)
            if is_array(value) {
                for_each(array!(value)) -> |_index, item| {
                    if is_object(item) || is_array(item) { __complex = true }
                }
            }
            __spill = if __complex { encode_json(value) } else { value }
            __residual = set!(__residual, [__key], __spill)
        }
    }
}
# Names nano owns in unmapped (the parser markers and the reserved nano.*
# namespace) are never taken by a source field: a vendor key with such a name
# is kept, renamed source_<name>, so a log cannot forge a marker.
if match(encode_json(keys(__residual)), r'"nano(?:"|\.|_time_assumed_tz"|_time_source"|_operational")') {
    for_each(object!(__residual)) -> |key, value| {
        if includes(["nano", "nano_time_assumed_tz", "nano_time_source", "nano_operational"], key) || starts_with(key, "nano.") {
            # source_<name>, or the next free _2, _3, ... when a vendor key
            # already holds that name: nothing is lost.
            __rk = "source_" + key
            __rn = 2
            if includes(keys(__residual), __rk) {
                for_each(__residual) -> |_other_key, _other_value| {
                    if includes(keys(__residual), __rk) {
                        __rk = "source_" + key + "_" + to_string(__rn)
                        __rn = __rn + 1
                    }
                }
            }
            __residual = remove!(__residual, [key])
            __residual = set!(__residual, [__rk], value)
        }
    }
}
# Keep existing derived evidence, but remove null placeholders and copies of a
# source value (that value is mapped or spilled above under its source path).
# A value merely equal to some mapped attribute is kept: equality with an
# unrelated attribute is no evidence that it is represented.
# The canonical source spill above is the authoritative representation of
# containers. The cheap conditions run first; the source value set is built on
# first use.
__original_values = null
for_each(flatten(__existing)) -> |key, value| {
    if !is_null(value) && value != "" && !is_array(value) && !is_object(value) && value != __raw_body {
        # Members for the value itself and for to_string(value), as above.
        __json = encode_json(value)
        __as_json = "," + encode_json(__json)
        __as_string = __as_json
        if is_string(value) { __as_string = "," + __json } else if is_float(value) { __as_string = "," + encode_json(to_string!(value)) }
        if __original_values == null {
            # __source_kv may hold non-JSON types (a timestamp), so only an
            # integer or a boolean skips its to_string member here.
            __original_values = join!(map_values(values(flatten(__source_kv))) -> |source_value| {
                __source_json = encode_json(source_value)
                __tokens = "," + encode_json(__source_json)
                if is_string(source_value) {
                    __tokens = __tokens + "," + __source_json
                } else if !is_object(source_value) && !is_array(source_value) && !is_integer(source_value) && !is_boolean(source_value) {
                    __tokens = __tokens + "," + encode_json(to_string(source_value) ?? "")
                }
                __tokens
            }, "")
        }
        __source_set = string!(__original_values)
        __keep = !contains(__source_set, __as_json) && !contains(__source_set, __as_string)
        # Only text opening an object or an array (after JSON whitespace)
        # decodes to a container.
        if __keep && is_string(value) && match(string!(value), r'^[ \t\n\r]*[\x5B\x7B]') {
            __decoded, __decode_err = parse_json(string!(value))
            __keep = !(__decode_err == null && (is_object(__decoded) || is_array(__decoded)))
        }
        if __keep {
            __key = snakecase(key)
            if !includes(keys(__residual), __key) { __residual = set!(__residual, [__key], value) }
        }
    }
}
# Parser-declared derived evidence is merged after source spill, as-is. These
# entries preserve meaning beyond source scalar value equality.
for_each(__preserve) -> |_index, key| {
    __derived = get!(object!(__copy.existing), [string!(key)])
    if __derived != null { __residual = set!(__residual, [string!(key)], __derived) }
}
if __time_assumed && !__time_inline { __residual = set!(__residual, ["nano_time_assumed_tz"], __src_tz_label) }
__discard = del(.unmapped)
if !is_empty(__residual) { .unmapped = __residual }
.
# END NAN-2421 residual spill
