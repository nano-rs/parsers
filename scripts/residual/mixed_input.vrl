# A source that writes both JSON records and text lines reaches its parser in
# any of these shapes (nanosiem config/vector/02-hec-source.toml hec_normalize,
# nanosiem-core src/parsers/vector_config/hec_payload.rs):
#   - a text line, or a JSON record (HTTP /ingest, an HEC string event);
#   - an HEC / OTel object whose `message` is a text line of this source: a
#     wrapper, its other keys the sender's;
#   - over HEC, only an event's own `message` (an object message, or a text a
#     forwarder added beside the record) while the whole event waits in event
#     metadata, %nano_hec_event.
# The parser sets, before the marker:
#   __mx_body  the delivered body as a string (its own rule for a non-string
#              .message: a source that decoded the record may hand it over);
#   __mx_line  a regex matching this source's text lines (and nothing else);
#   __mx_keys  keys of which any one marks an object as a record of this source.
# This block sets:
#   __mx_raw      the body (raw_data);
#   __mx_record   the JSON record, or {};
#   __mx_text     the text line, or "";
#   __mx_wrapper  a wrapper's other keys (source fields: map or spill them), or {}.
# A record taken from %nano_hec_event is removed from there, so nano does not
# file its keys a second time.
__mx_raw = __mx_body
__mx_record = {}
__mx_text = ""
__mx_wrapper = {}
__mx_json, __mx_json_err = parse_json(__mx_raw)
if __mx_json_err == null && is_object(__mx_json) {
    __mx_obj = object!(__mx_json)
    __mx_inner = __mx_obj.message
    if is_string(__mx_inner) && match(string!(__mx_inner), __mx_line) {
        __mx_text = string!(__mx_inner)
        __mx_wrapper = __mx_obj
        __mx_wrapper = remove!(__mx_wrapper, ["message"])
    } else {
        __mx_record = __mx_obj
    }
} else if __mx_json_err != null {
    __mx_text = __mx_raw
}
__mx_rec_ok = false
for_each(__mx_keys) -> |_i, __mx_k| {
    if (get(__mx_record, [string!(__mx_k)]) ?? null) != null { __mx_rec_ok = true }
}
__mx_stash = %nano_hec_event
if !__mx_rec_ok && is_object(__mx_stash) && !(__mx_text != "" && match(__mx_text, __mx_line)) {
    __mx_st = object!(__mx_stash)
    __mx_st_ok = false
    for_each(__mx_keys) -> |_i, __mx_k| {
        if (get(__mx_st, [string!(__mx_k)]) ?? null) != null { __mx_st_ok = true }
    }
    if __mx_st_ok {
        __mx_record = __mx_st
        __mx_raw = encode_json(__mx_st)
        __mx_text = ""
        __mx_wrapper = {}
        del(%nano_hec_event)
    }
}
